  "cards": [
    {
      "dot": "rose",
      "title": "Trust & Security Boundaries",
      "items": [
        "Client Zone: Untrusted external user traffic over TLS/HTTPS and WebSocket Secure (WSS)",
        "Application Container: Containerized Tomcat 9 boundary enforcing BCrypt auth & role-based route guards",
        "Database Tier: Isolated MySQL 8.0 network tier with parameterized PreparedStatements",
        "External AI Cloud: Outbound HTTPS to Google Gemini with clinical emergency pre-screening"
      ]
    },
    {
      "dot": "emerald",
      "title": "Clinical & Scheduling Core",
      "items": [
        "Sakura AI: 5-layer clinical triage protocol with sub-second emergency detection override",
        "Collision-Free Queue: Deterministic sequential 15-minute slot allocator (09:00 AM + (N-1)*15m)",
        "WebSocket Hub: Full-duplex live waiting-room queue state broadcast to connected displays",
        "RAG Knowledge Base: Real-time doctor, specialty, OPD timing, and hospital facility injection"
      ]
    },
    {
      "dot": "cyan",
      "title": "Pharmacy & Administrative Services",
      "items": [
        "Digital Prescriptions: Doctor-authored structured medication plans linked to appointment records",
        "E-Pharmacy Storefront: 23,400+ authentic medicines with persistent carts and multi-address checkout",
        "Compliance & Reporting: One-click Apache POI Excel (.xlsx) and OpenPDF report generation"
      ]
    }
  ]
