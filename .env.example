# ==============================================================================
# Iryotek Healthcare Management Platform — Environment Configuration Template
# ==============================================================================

# Database Connectivity (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital
DB_USER=root
DB_PASSWORD=admin
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Application Server (Apache Tomcat / Jetty)
SERVER_PORT=8080
CONTEXT_PATH=/hospital

# Google Gemini Pro AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# JavaMail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@iryotek.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# Frontend Client (Vite Dev Server)
VITE_PORT=8443
VITE_BACKEND_URL=http://localhost:8080/hospital
